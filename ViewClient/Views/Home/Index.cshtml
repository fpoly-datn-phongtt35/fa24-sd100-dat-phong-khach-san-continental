@using System.Diagnostics
@using Domain.DTO.Floor
@using Domain.DTO.RoomType
@using Domain.Enums
@using Domain.DTO.Paging
@using ViewClient.Views.Shared
@model ResponseData<Domain.DTO.Room.RoomResponse>
@{
    ViewBag.Title = "Continental";
    var roomtypeList = ViewBag.RoomTypes as List<Domain.DTO.RoomType.RoomTypeResponse>;
    var groupedData = Model.data.GroupBy(d => d.RoomTypeId);
}

<div class="banner">
    <img src="~/img/banner_khach_san.jpg" alt="Khách Sạn Continental">
    <div class="text-overlay">
        <h1>✨ Khách Sạn Continental – Biểu Tượng Đẳng Cấp & Lịch Sử ✨</h1>
        <p>Nằm giữa trung tâm thành phố, nơi vẻ đẹp lịch sử giao thoa với tiện nghi hiện đại.</p>
    </div>
</div>
<div class="search-box container">
    <form class="d-flex align-items-center justify-content-center">
        <div class="row g-3">
            <div class="col-md-3">
                <h6 for="checkIn" class="form-label">Ngày Nhận Phòng</h6>
                <input type="date" id="checkIn" name="checkIn" class="form-control" title="Ngày nhận phòng" required>
            </div>
            <div class="col-md-3">
                <h6 for="checkOut" class="form-label">Ngày Trả Phòng</h6>
                <input type="date" id="checkOut" name="checkOut" class="form-control" title="Ngày trả phòng" required>
            </div>
            <div class="col-md-3">
                <h6 for="maxiumOccupancy" class="form-label">Số Người</h6>
                <input type="number" id="maxiumOccupancy" name="maxiumOccupancy" class="form-control" title="Số người" min="1" max="50" required>
            </div>
            <div class="col-md-3">
                <h6 for="quantityRoom" class="form-label">Số Lượng Phòng</h6>
                <input type="number" id="quantityRoom" name="quantityRoom" class="form-control" title="Số lượng phòng" min="1" max="25" required>
            </div>
        </div>
        <div class="text-center ms-lg-2" style="margin-left: 30px; margin-top:28px;">
            <button type="submit" id="validateButton" class="btn btn-danger"><i class="fa-solid fa-magnifying-glass" style="color: #ffffff;"></i>Tìm Kiếm</button>
        </div>
    </form>
</div>
<div class="container">
    @if (!groupedData.Any())
    {
        <h3 style="color:#F04770;" class="text-center">Hãy nhập vào thông tin để tìm kiếm phòng!</h3>
    }
    else
    {
        foreach (var group in groupedData)
        {
            var roomType = roomtypeList.FirstOrDefault(rt => rt.Id == group.Key);
            if (roomType != null)
            {
                <h4 class="room-type-title d-flex">
                    Loại phòng: <p style="color:#108AB1;" class="text-uppercase"> @roomType.Name</p> -
                    Số lượng người/phòng: <p style="color:#108AB1;" class="text-uppercase"> @roomType.MaximumOccupancy</p>
                </h4>
                <div class="row gap-0">
                    @if (group != null && group.Any())
                    {
                        @foreach (var room in group)
                        {
                            <div class="col-lg-3 col-md-3 col-sm-4 mb-1 p-4">
                                <a href="@Url.Action("Details", "Room", new { roomId = room.Id })" class="card-link">
                                    <div class="card no-border">
                                        @if (room.Images != null && room.Images.Any(i => !string.IsNullOrEmpty(i.Image)))
                                        {
                                            <div id="carousel-@room.Id.ToString("N")" class="carousel slide" data-bs-ride="carousel" data-bs-touch="false" data-bs-interval="false">
                                                <div class="carousel-inner">
                                                    @foreach (var img in room.Images.Where(i => !string.IsNullOrEmpty(i.Image)))
                                                    {
                                                        var imagePath = Url.Content($"~/images/{img.Image}");

                                                        <div class="carousel-item @(img == room.Images.First() ? "active" : "")">
                                                            <div class="img-container">
                                                                <img src="@Url.Content($"~/images/{System.IO.Path.GetFileName(img.Image)}")"
                                                                     class="d-block w-100"/>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@room.Id.ToString("N")" data-bs-slide="prev">
                                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                    <span class="visually-hidden">Previous</span>
                                                </button>
                                                <button class="carousel-control-next" type="button" data-bs-target="#carousel-@room.Id.ToString("N")" data-bs-slide="next">
                                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                    <span class="visually-hidden">Next</span>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Hiển thị ảnh mặc định nếu không có ảnh -->
                                            <div class="img-container">
                                                <img src="~/images/default.jpg" alt="No Image Available" class="d-block w-100" />
                                            </div>
                                        }

                                        <i class="fas fa-heart heart-icon"></i>
                                        <h5 class="card-title" style="color:black;">@room.Name</h5>
                                        <p>đ @String.Format("{0:N0}", room.Price) / ngày</p>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center">Không có phòng nào để hiển thị.</p>
                    }
                </div>
            }
        }
    }
</div>
