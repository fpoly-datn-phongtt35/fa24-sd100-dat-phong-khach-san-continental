@using System.Diagnostics
@using Domain.DTO.Floor
@using Domain.DTO.Room
@using Domain.DTO.RoomType
@using Domain.Enums
@using Domain.DTO.Paging
@using ViewClient.Views.Shared
@model ResponseData<Domain.DTO.Room.RoomResponse>
@{
    ViewBag.Title = "Continental";
    var roomtypeList = ViewBag.RoomTypes as List<Domain.DTO.RoomType.RoomTypeResponse>;
    var allRooms = Model.data;
    var averageRatings = (Dictionary<Guid, RoomRatingDto>)ViewBag.AverageRatings;

}

<style>
    .search-form-container {
        margin: 20px 0;
    }

    .banner {
        width: 100%;
        height: auto;  
    }

    .carousel-inner,
    .carousel-item,
    .carousel-item img {
        width: 100%;
        height: auto;  
        object-fit: contain;  
    }

    .mt-2rem {
        margin-top: 1.3rem;
    }
    .form-row {
        display: flex;
        justify-content: space-between; /* Căn chỉnh các thành phần trên một hàng */
    }

    .form-group {
        flex: 0.5; 
        margin-right: 10px;
    }

        .form-group:last-child {
            margin-right: 0;
        }

    .form-buttons {
        margin-top: 15px;
    }
</style>
<div class="banner">
    <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/bn1.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/bn2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/bn3.jpg" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    @*<div class="text-overlay">     
        <a href="@Url.Action("Introduce", "Home")" class="btn btn-dark btn-lg" style="z-index:1000;">Tìm hiểu thêm</a>
    </div>*@
</div>
<div class="search-box container">
    <form class="d-flex align-items-center justify-content-center">
        <div class="row g-3">
            <div class="col-md-3">
                <h6 for="checkIn" class="form-label">Ngày Nhận Phòng</h6>
                <input type="date" id="checkIn" name="checkIn" class="form-control" title="Ngày nhận phòng" required>
            </div>
            <div class="col-md-3">
                <h6 for="checkOut" class="form-label">Ngày Trả Phòng</h6>
                <input type="date" id="checkOut" name="checkOut" class="form-control" title="Ngày trả phòng" required>
            </div>
            <div class="col-md-3">
                <h6 for="maxiumOccupancy" class="form-label">Số Người</h6>
                <input type="number" id="maxiumOccupancy" name="maxiumOccupancy" class="form-control" title="Số người" min="1" max="50" required>
            </div>
            <div class="col-md-3">
                <h6 for="quantityRoom" class="form-label">Số Lượng Phòng</h6>
                <input type="number" id="quantityRoom" name="quantityRoom" class="form-control" title="Số lượng phòng" min="1" max="25" required>
            </div>
        </div>
        <div class="text-center ms-lg-2" style="margin-left: 30px; margin-top:28px;">
            <button type="submit" id="validateButton" class="btn btn-dark"><i class="fa-solid fa-magnifying-glass" style="color: #ffffff;"></i>Tìm Kiếm</button>
        </div>
    </form>
</div>

<div class="py-4">
    @if (!allRooms.Any())
    {
        <div id="top-booked-rooms-container">
            @await Component.InvokeAsync("TopBookedRooms", new { type = "top-booked" })
        </div>
        @*<div id="top-booked-rooms-container">
            @await Component.InvokeAsync("TopBookedRooms", new { type = "nice-view" })
        </div>*@
    }
    else
    {
        <div class="search-form-container ps-5">
            <form asp-action="SearchRooms" method="get" class="search-form">
                <input type="hidden" name="CheckIn" id="CheckInValue" />
                <input type="hidden" name="CheckOut" id="CheckOutValue" />
                <input type="hidden" name="maxiumOccupancy" id="MaxOccupancyValue" />
                <input type="hidden" name="quantityRoom" id="QuantityRoomValue" />

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label for="RoomTypeId">Loại Phòng</label>
                        <select name="RoomTypeId" id="RoomTypeId" class="form-control">
                            <option value="">-- Chọn Loại Phòng --</option>
                            @foreach (var roomType in ViewBag.RoomTypes)
                            {
                                <option value="@roomType.Id">@roomType.Name / Số lượng người @roomType.MaximumOccupancy</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-3 mr-0">
                        <label for="FloorId">Tầng</label>
                        <select name="FloorId" id="FloorId" class="form-control">
                            <option value="">-- Chọn Tầng --</option>
                            @foreach (var floor in ViewBag.FloorList)
                            {
                                <option value="@floor.Id">@floor.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2 mt-2rem">
                        <label>&nbsp;</label>
                        <button type="submit" class="btn btn-dark w-50">Lọc</button> 
                    </div>
                </div>
            </form>
        </div>

        <div class="container py-4">
            @if (allRooms != null && allRooms.Any())
            {
                @foreach (var room in allRooms)
                {
                    var rating = averageRatings.ContainsKey(room.Id) ? averageRatings[room.Id] : new RoomRatingDto();
                    var roomType = roomtypeList.FirstOrDefault(rt => rt.Id == room.RoomTypeId);
                    <div class="card mb-4 shadow-sm border-0">
                        <div class="row g-0 align-items-center">
                            <div class="col-md-5 position-relative">
                                @if (room.Images != null && room.Images.Any(i => !string.IsNullOrEmpty(i.Image)))
                                {
                                    <div id="carousel-@room.Id.ToString("N")" class="carousel slide" data-bs-ride="carousel" data-bs-touch="false" data-bs-interval="false">
                                        <div class="carousel-inner rounded-start">
                                            @foreach (var img in room.Images.Where(i => !string.IsNullOrEmpty(i.Image)))
                                            {
                                                <div class="carousel-item @(img == room.Images.First() ? "active" : "")">
                                                    <img src="@Url.Content($"~/images/{System.IO.Path.GetFileName(img.Image)}")" class="d-block w-100" style="height: 250px; object-fit: cover;" />
                                                </div>
                                            }
                                        </div>
                                      
                                    </div>
                                }
                                else
                                {
                                    <img src="~/images/default.jpg" alt="No Image" class="img-fluid rounded-start w-100" style="height: 250px; object-fit: cover;" />
                                }
                            </div>

                            <div class="col-md-7">
                                <div class="card-body p-4">
                                    <h2 class="card-title text-black fw-semibold mb-2" style="font-size: 1.5rem;">
                                        @room.Name
                                    </h2>

                                    <p class="mb-3 text-black">
                                        <span style="font-size: 1.1rem; font-weight: 500;">
                                            @rating.AverageRating
                                            <i class="bi bi-star ms-1" style="font-size: 1.2rem;"></i>
                                        </span>
                                        <small class="ms-1" style="font-size: 0.9rem; opacity: 0.7;">
                                            (@rating.TotalReviews review)
                                        </small>
                                    </p>

                                    <p class="mb-2 text-black d-flex align-items-center">
                                        <i class="bi bi-people me-2"></i>
                                        <span>Sức chứa: <strong>@roomType?.MaximumOccupancy</strong> người</span>
                                    </p>

                                    <p class="mb-2 text-black d-flex align-items-center">
                                        <i class="bi bi-layout-text-sidebar-reverse me-2"></i>
                                        <span>Loại phòng: <strong class="text-uppercase">@roomType?.Name</strong></span>
                                    </p>

                                    <p class="mb-3 text-black d-flex align-items-center">
                                        <i class="bi bi-cash me-2"></i>
                                        <span>Giá: <strong class="text-black">đ @($"{room.Price:N0}")</strong> / ngày</span>
                                    </p>

                                    <a href="@Url.Action("Details", "Room", new { roomId = room.Id })"
                                       class="btn btn-outline-dark rounded-pill px-4 py-2 fw-medium shadow-sm d-inline-flex align-items-center">
                                        <i class="me-2"></i>Đặt phòng ngay
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Không có phòng nào để hiển thị.</p>
            }
        </div>

    }
</div>

@section scripts {
    <script asp-append-version="true" src="~/module/searchRoom.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}