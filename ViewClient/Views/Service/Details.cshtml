@model Domain.Models.Service

@{
    ViewData["Title"] = "Details";
}

<style>
    /* Container và bố cục tổng thể */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* Header */
    .header-background {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        border-radius: 10px;
        padding: 40px 20px;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .header-content {
        text-align: center;
        color: #ffffff;
    }

    .header-content .title {
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .header-content .price-highlight {
        background-color: #f1c40f;
        color: #1e3c72;
        padding: 5px 15px;
        border-radius: 5px;
        font-weight: bold;
    }

    /* Content Container */
    .content-container {
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-bottom: 30px;
    }

    /* Service Details */
    .service-details {
        display: flex;
        gap: 30px;
    }

    /* Image Container */
    .image-container {
        flex: 1;
        max-width: 400px;
    }

    .carousel {
        position: relative;
        width: 350px;
        height: 250px;
        overflow: hidden;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .carousel img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .carousel img.active {
        opacity: 1;
    }

    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        color: #ffffff;
        border: none;
        padding: 10px;
        cursor: pointer;
        font-size: 18px;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

    .carousel-btn:hover {
        background-color: rgba(0, 0, 0, 0.7);
    }

    .carousel-btn.prev {
        left: 10px;
    }

    .carousel-btn.next {
        right: 10px;
    }

    .image-container p {
        text-align: center;
        color: #777;
        font-size: 16px;
        padding: 20px;
        background-color: #f5f5f5;
        border-radius: 8px;
        margin: 0;
    }

    /* Service Info */
    .service-info {
        flex: 1;
        line-height: 1.6;
    }

    .service-info h3 {
        font-size: 24px;
        font-weight: bold;
        color: #1e3c72;
        margin-bottom: 15px;
    }

    .service-info p {
        font-size: 16px;
        color: #333;
        margin-bottom: 20px;
    }

    .service-info .btn-book {
        display: inline-block;
        padding: 10px 20px;
        background-color: #2a5298;
        color: #ffffff;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

    .service-info .btn-book:hover {
        background-color: #1e3c72;
    }
</style>

<div class="container">
    <div class="header-background">
        <div class="header-content">
            <h1 class="title">Trải nghiệm @Model.Name</h1>
            <h5><strong>Giá chỉ từ:</strong> <span class="price-highlight">@Model.Price.ToString("#,##0") VND</span></h5>
        </div>
    </div>
</div>

<div class="container">
    <div class="content-container">
        <div class="service-details">
            <div class="image-container">
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="carousel">
                        @foreach (var image in Model.Images)
                        {
                            var extension = System.IO.Path.GetExtension(image.Image)?.ToLower();
                            if (new[] { ".jpg", ".jpeg", ".png", ".gif" }.Contains(extension))
                            {
                                var fileName = System.IO.Path.GetFileName(image.Image);
                                var imagePath = Url.Content($"~/images/service/{fileName}");

                                <img src="@imagePath" alt="Service Image" class="@(Model.Images.First() == image ? "active" : "")" />
                            }
                        }
                        @if (Model.Images.Count(i => new[] { ".jpg", ".jpeg", ".png", ".gif" }.Contains(System.IO.Path.GetExtension(i.Image)?.ToLower())) > 1)
                        {
                            <button class="carousel-btn prev">&#10094;</button>
                            <button class="carousel-btn next">&#10095;</button>
                        }
                    </div>
                }
                else
                {
                    <p>Không có hình ảnh để hiển thị</p>
                }
            </div>

            <div class="service-info">
                <h3>Bạn sẽ trải nghiệm</h3>
                <p>@Model.Description</p>
                <a href="#" class="btn-book">Đặt ngay</a>
            </div>
        </div>
    </div>
</div>

<script>
    // JavaScript cho carousel
    document.querySelectorAll('.carousel').forEach(carousel => {
        const images = carousel.querySelectorAll('img');
        const prevBtn = carousel.querySelector('.prev');
        const nextBtn = carousel.querySelector('.next');
        let currentIndex = 0;

        function showImage(index) {
            images.forEach((img, i) => {
                img.classList.toggle('active', i === index);
            });
        }

        if (prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                showImage(currentIndex);
            });

            nextBtn.addEventListener('click', () => {
                currentIndex = (currentIndex + 1) % images.length;
                showImage(currentIndex);
            });
        }
    });
</script>