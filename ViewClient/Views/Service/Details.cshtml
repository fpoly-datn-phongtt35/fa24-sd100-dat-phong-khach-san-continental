@model Domain.Models.Service

@{
    ViewData["Title"] = "Details";
}

<div class="header-wrapper">
    <div class="header-background">
        <div class="header-content">
            <h1 class="title py-3">Trải nghiệm @Model.Name</h1>
            <h5><strong>Bắt đầu từ:</strong> <span class="price-highlight">@Model.Price VNĐ</span></h5>
        </div>
    </div>
</div>

<div class="content-container">
    <div class="service-details">
        <div class="image-container pt-3">
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div class="d-flex flex-wrap image-gallery">
                    @foreach (var image in Model.Images)
                    {
                        var extension = System.IO.Path.GetExtension(image.Image);
                        if (new[] { ".jpg", ".jpeg", ".png", ".gif" }.Contains(extension.ToLower()))
                        {
                            var fileName = System.IO.Path.GetFileName(image.Image);
                            var imagePath = Url.Content($"/View/wwwroot/images/service/{fileName}");

                            <div class="image-item m-2">
                                <img src="@imagePath" alt="Service Image" class="service-image" />
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <p>Không có hình ảnh</p>
            }
        </div>

        <div class="service-info">
            <p><strong>Bạn sẽ trải nghiệm:</strong> @Model.Description</p>
        </div>
    </div>
</div>

<style>
    /* Vùng chứa header */
    .header-wrapper {
        width: 100%;
        background: linear-gradient(135deg, #0078D7, #4DAFFF);
        border-bottom-left-radius: 50px;
        position: relative;
        overflow: hidden;
    }

    /* Nền xanh và kiểm soát chiều cao */
    .header-background {
        padding: 120px 0;
        text-align: left;
    }

    /* Nội dung bên trong header */
    .header-content {
        max-width: 70%;
        margin: 0 auto;
        color: white;
        transform: translateY(-50px);
    }

        .header-content .title {
            font-size: 2.5em;
            font-weight: bold;
            margin: 0;
        }

    .price-highlight {
        color: #FFD700;
        font-weight: bold;
        font-size: 1.2em;
    }

    /* Container cho nội dung chính */
    .content-container {
        max-width: 70%;
        margin: 0 auto;
        padding: 20px;
    }

    .service-details {
        padding: 20px;
        background: white;
        border-radius: 10px;
        box-shadow: none;
        border: none;
    }

    /* Hình ảnh dịch vụ */
    .image-container {
        position: relative;
        margin-bottom: 20px;
        margin-top: -180px;
        z-index: 1;
    }

    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 16px; /* Khoảng cách giữa các ảnh */
    }

    .image-item {
        flex: 0 0 calc(33.33% - 10.67px); /* 33.33% cho 3 ảnh mỗi hàng, trừ đi phần khoảng cách */
        max-width: calc(33.33% - 10.67px);
    }

    .service-image {
        width: 100%;
        height: 500px; /* Chiều cao cố định cho tất cả ảnh */
        object-fit: cover; /* Giữ tỷ lệ ảnh, cắt bớt nếu cần */
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .service-info {
        margin-top: 20px;
        padding: 20px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .service-info p {
            font-size: 1.2em;
            margin-bottom: 10px;
        }
</style>