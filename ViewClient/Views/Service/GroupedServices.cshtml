@using ViewClient.ViewModels
@model ApiResponse

<div class="container-fluid flex-grow-1 d-flex flex-column align-items-center">
    <main style="width: 100%;">
        <img src="@Url.Content("~/img/banner_service.png")" alt="Service Banner" style="width: 100vw;
        height: auto; max-height: 400px; object-fit: cover; display: block; margin-bottom: 20px;">

        <!-- Dining Section -->
        <div class="dining-section" style="padding: 40px 20px; text-align: center; max-width: 1200px; margin: 0 auto;">
            <h1 style="font-size: 32px; margin-bottom: 40px; text-align: center;">
                <span style="font-size: 15px; color: #888888;">DỊCH VỤ TẠI KHÁCH SẠN CONTINENTAL</span><br>
                <br>
                <span style="font-size: 36px; font-weight: bold;">TẬN HƯỞNG ĐỒ ĂN, THỨC UỐNG VÀ CÁC DỊCH VỤ</span><br>
                <span style="font-size: 36px; font-weight: bold;">KHÁC TẠI CONTINENTAL</span><br>
                <br>
                <br>
                <span style="font-size: 15px; color: #888888">TẠI KHÁCH SẠN NÀY</span>
            </h1>

            @{
                var imageList = new List<string>
            {
            "~/images/service/2f317dfa-6540-4ed8-bf07-d5985d4b6d8a.jpg",
            "~/images/service/Transport1_1.jpg",
            "~/img/the-market.png",
            "~/images/service/RoomSer1_1.jpg",
            "~/images/service/Spa1_1.jpg",
            "~/images/service/Tour1_5.jpg",
            "~/images/service/Conference1_1.jpg"

            };
                var index = 0;
            }
            @if (Model?.Data?.Any() == true)
            {
                var isOdd = true;
                foreach (var group in Model.Data)
                {
                    var imagePath = imageList[index % imageList.Count];
                    index++;

                    var itemClass = isOdd ? "dining-item odd" : "dining-item even";

                    <div class="@itemClass" style="display: flex; gap: 20px; margin-bottom: 40px; text-align: left; border: 1px solid #ddd; border-radius: 10px; padding: 20px; box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.1); max-width: 800px; margin-left: auto; margin-right: auto; min-height: 300px;">
                        <div class="image-container" style="width: 400px; height: 250px; border-radius: 10px; overflow: hidden;">
                            @{
                                var extension = System.IO.Path.GetExtension(imagePath)?.ToLower();
                                if (new[] { ".jpg", ".jpeg", ".png", ".gif" }.Contains(extension))
                                {
                                    <img src="@Url.Content(imagePath)" alt="@group.ServiceTypeName" style="width: 100%; height: 100%; object-fit: cover; border-radius: 10px;">
                                }
                                else
                                {
                                    <p style="text-align: center; color: #555; margin-top: 100px;">Không có hình ảnh</p>
                                }
                            }
                        </div>
                        <div class="content" style="flex: 1; max-width: 350px;">
                            <h2 style="font-size: 24px; margin-bottom: 10px; font-weight: bold;">@(string.IsNullOrWhiteSpace(group.ServiceTypeName) ? "Unknown Type" : group.ServiceTypeName.ToUpper())</h2>
                            <p style="color: #C0C0C0">Bao gồm</p>
                            <div class="details" style="font-size: 20px; color: #555;">
                                @for (int i = 0; i < group.ServiceNames.Count; i++)
                                {
                                    <p style="margin: 0;">
                                        <a href="@Url.Action("Details", "Service", new { id = group.ServiceIds[i] })" style="text-decoration: none; color: #000000;">
                                            @group.ServiceNames[i]
                                        </a>
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    isOdd = !isOdd;
                }
                //phân trang
                @if (Model.TotalPage > 1)
                {
                    <div class="pagination" style="text-align: center; margin-top: 40px;">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("GroupedServices", new { pageIndex = Model.CurrentPage - 1, pageSize = Model.PageSize })" aria-label="Previous">
                                            <span aria-hidden="true">« Trước</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">« Trước</span>
                                    </li>
                                }

                                @{
                                    int startPage = Math.Max(1, Model.CurrentPage - 2);
                                    int endPage = Math.Min(Model.TotalPage, Model.CurrentPage + 2);

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("GroupedServices", new { pageIndex = 1, pageSize = Model.PageSize })">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        if (i == Model.CurrentPage)
                                        {
                                            <li class="page-item active"><span class="page-link">@i</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("GroupedServices", new { pageIndex = i, pageSize = Model.PageSize })">@i</a>
                                            </li>
                                        }
                                    }

                                    if (endPage < Model.TotalPage)
                                    {
                                        if (endPage < Model.TotalPage - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("GroupedServices", new { pageIndex = Model.TotalPage, pageSize = Model.PageSize })">@Model.TotalPage</a>
                                        </li>
                                    }
                                }

                                @if (Model.CurrentPage < Model.TotalPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("GroupedServices", new { pageIndex = Model.CurrentPage + 1, pageSize = Model.PageSize })" aria-label="Next">
                                            <span aria-hidden="true">Sau »</span>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">Sau »</span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <p style="text-align: center; color: red;">Không có dữ liệu để hiển thị.</p>
            }
        </div>

        <!-- FAQ Section -->
        <div class="faq-section" style="padding: 40px 20px; background: #f9f9f9; max-width: 1200px; margin: 0 auto;">
            <h2 style="font-size: 24px; margin-bottom: 20px; text-align: center; font-weight: bold;">CÂU HỎI THƯỜNG GẶP</h2>

            <div class="faq-item" style="border-top: 2px solid #ddd; border-bottom: 2px solid #ddd; padding: 10px 0; margin-bottom: 10px;">
                <div class="faq-question" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding-bottom: 10px;" onclick="toggleAnswer(this)">
                    <h3 style="font-size: 18px; margin-bottom: 0; color: #000000; font-weight: normal;">Khách sạn Continental có những nhà hàng nào tại khuôn viên?</h3>
                    <span class="faq-toggle" style="font-size: 16px;">▼</span>
                </div>
                <div class="faq-answer" style="display: none; font-size: 14px; color: #555; margin-top: 20px;">
                    Các nhà hàng tại khuôn viên của Khách sạn Continental bao gồm: Con Highlands và một số lựa chọn khác.
                </div>
            </div>

            <div class="faq-item" style="border-bottom: 2px solid #ddd; padding: 10px 0; margin-bottom: 10px;">
                <div class="faq-question" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding-bottom: 10px;" onclick="toggleAnswer(this)">
                    <h3 style="font-size: 18px; margin-bottom: 0; color: #000000; font-weight: normal;">Khách sạn Continental có cung cấp dịch vụ phòng không?</h3>
                    <span class="faq-toggle" style="font-size: 16px;">▼</span>
                </div>
                <div class="faq-answer" style="display: none; font-size: 14px; color: #555; margin-top: 20px;">
                    Không, Khách sạn Continental hiện không cung cấp dịch vụ phòng. Bạn có thể xem các lựa chọn ăn uống khác trên trang dịch vụ của chúng tôi.
                </div>
            </div>

            <div class="faq-item" style="border-bottom: 2px solid #ddd; padding: 10px 0; margin-bottom: 10px;">
                <div class="faq-question" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding-bottom: 10px;" onclick="toggleAnswer(this)">
                    <h3 style="font-size: 18px; margin-bottom: 0; color: #000000; font-weight: normal;">Khách sạn Continental cung cấp các loại ẩm thực nào?</h3>
                    <span class="faq-toggle" style="font-size: 16px;">▼</span>
                </div>
                <div class="faq-answer" style="display: none; font-size: 14px; color: #555; margin-top: 20px;">
                    Các loại ẩm thực được cung cấp tại Khách sạn Continental bao gồm: Ẩm thực địa phương tại Con Highlands và các lựa chọn khác.
                </div>
            </div>

            <div class="faq-item" style="border-bottom: 2px solid #ddd; padding: 10px 0; margin-bottom: 10px;">
                <div class="faq-question" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding-bottom: 10px;" onclick="toggleAnswer(this)">
                    <h3 style="font-size: 18px; margin-bottom: 0; color: #000000; font-weight: normal;">Làm thế nào để đặt bàn tại một trong những nhà hàng tại Khách sạn Continental?</h3>
                    <span class="faq-toggle" style="font-size: 16px;">▼</span>
                </div>
                <div class="faq-answer" style="display: none; font-size: 14px; color: #555; margin-top: 20px;">
                    Để đặt bàn tại Con Highlands, vui lòng nhấn vào đây; Bạn cũng có thể gọi +1 828-4821581 để đặt chỗ.
                </div>
            </div>

            <div class="faq-item" style="border-bottom: 2px solid #ddd; padding: 10px 0; margin-bottom: 10px;">
                <div class="faq-question" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding-bottom: 10px;" onclick="toggleAnswer(this)">
                    <h3 style="font-size: 18px; margin-bottom: 0; color: #000000; font-weight: normal;">Khách sạn Continental có cung cấp bữa sáng miễn phí không?</h3>
                    <span class="faq-toggle" style="font-size: 16px;">▼</span>
                </div>
                <div class="faq-answer" style="display: none; font-size: 14px; color: #555; margin-top: 20px;">
                    Hiện tại, Khách sạn Continental không phục vụ bữa sáng miễn phí. Xem các lựa chọn ăn uống tại chỗ và gần đó trên trang dịch vụ của chúng tôi.
                </div>
            </div>
        </div>
    </main>
</div>

<style>
    .faq-question:hover {
        color: #007bff;
    }

    .faq-answer {
        transition: all 0.3s ease;
    }

    .faq-toggle {
        transition: transform 0.3s ease;
    }

        .faq-toggle.open {
            transform: rotate(180deg);
        }

    .dining-item.odd {
        flex-direction: row;
    }

    .dining-item.even {
        flex-direction: row-reverse;
    }

    .content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .pagination .page-link {
        color: #007bff;
        border: 1px solid #ddd;
        margin: 0 5px;
        padding: 8px 16px;
        border-radius: 5px;
    }

    .pagination .page-item.active .page-link {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
        cursor: not-allowed;
    }

    .pagination .page-link:hover {
        background-color: #f8f9fa;
        color: #0056b3;
    }
</style>

<script>
    function toggleAnswer(element) {
        const answer = element.nextElementSibling;
        const toggle = element.querySelector('.faq-toggle');

        if (answer.style.display === 'none' || answer.style.display === '') {
            answer.style.display = 'block';
            toggle.classList.add('open');
        } else {
            answer.style.display = 'none';
            toggle.classList.remove('open');
        }
    }
</script>