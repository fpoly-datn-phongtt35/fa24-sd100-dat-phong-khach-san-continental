@using Domain.DTO.Paging
@using ViewClient.Models.Paging
@using ViewClient.Views.Shared

@model ResponseData<Domain.DTO.RoomBooking.RoomBookingResponseForCustomer>

@{
    ViewData["Title"] = "Lịch sử đặt phòng";
}
<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        visibility: hidden;
        opacity: 0;
        transition: visibility 0s, opacity 0.3s;
        z-index: 9999;
    }

    .popup {
        background: white;
        padding: 30px;
        border-radius: 15px;
        width: 80%;
        max-width: 900px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        position: relative;
        z-index: 10000;
    }

    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        visibility: hidden;
        opacity: 0;
        transition: visibility 0s, opacity 0.3s;
        z-index: 9999;
    }

    .popup {
        background: white;
        padding: 40px;
        border-radius: 15px;
        width: 80%;
        max-width: 1000px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        position: relative;
        z-index: 10000;
        overflow-y: auto;
    }

    .table-responsive {
        max-height: 500px;
        overflow-y: auto;
    }
    .popup-overlay.show {
        visibility: visible;
        opacity: 1;
    }

    .popup-title {
        font-size: 28px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    .popup table th {
        background-color: #f8f9fa;
        text-align: center;
    }

    .popup table td {
        vertical-align: middle;
        text-align: center;
    }

    .popup-buttons {
        margin-top: 20px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        transition: background-color 0.3s;
    }

    .btn-outline-secondary {
        background-color: #f8f9fa;
        border: 1px solid #ccc;
    }

        .btn-outline-secondary:hover {
            background-color: #e2e6ea;
        }

    .btn-success {
        background-color: #333; /* Màu nền xám */
        border: 1px solid #333; /* Viền xám */
        color: white; /* Chữ màu trắng */
    }

        .btn-success:hover {
            background-color: #333; /* Màu nền khi hover (xám đậm hơn) */
            border-color: #333; /* Viền khi hover (xám đậm hơn) */
            color: white; /* Chữ vẫn trắng khi hover */
        }

    .popup-overlay.show {
        visibility: visible;
        opacity: 1;
    }

    .star {
        font-size: 30px;
        cursor: pointer;
        color: gray; /* Màu mặc định */
    }

        .star.selected {
            color: gold; /* Màu vàng khi được chọn */
        }

        .star:hover {
            color: gold; /* Màu vàng khi được chọn */
        }

    .popup h5 {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    .table th, .table td {
        text-align: center;
    }

    .form-control {
        width: 100%;
    }

    .banner {
        position: relative; /* Thêm position relative cho container của banner */
    }

    .luxury-card {
        background: rgba(255, 255, 255, 0.9); /* Lớp nền mờ để bảng không bị loá ánh sáng */
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    .btn-rating {
        cursor: pointer;
        margin-right: 5px;
    }
</style>

<div class="container pt-2">
    <div class="p-5 pb-1 pt-3 luxury-card" style="min-width: 85%">
        <h1>Lịch sử đặt phòng</h1>

        <table class="table table-responsive">
            <thead>
                <tr>
                    <th>
                        Phương thức đặt phòng
                    </th>
                    <th>
                        Tổng tiền thanh toán(Đã trừ cọc)
                    </th>
                    <th>
                        Tiền cọc
                    </th>
                    <th>
                        Tổng tiền phòng
                    </th>
                    <th>
                        Tổng tiền dịch vụ
                    </th>
                    <th>
                        Tổng tiền phụ thu
                    </th>
                    <th>
                        Trạng thái
                    </th>
                    <th>
                        Ngày tạo
                    </th>
                    <th style="min-width: 140px">
                        Thao tác
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.data != null && Model.data.Any())
                {
                    foreach (var item in Model.data)
                    {
                        <tr>
                            <td style="text-align:center;">@StatusHelper.DisplayBookingType(item.BookingType)</td>
                            <td>@item.TotalPrice?.ToString("N0")</td>
                            <td>@item.Deposit?.ToString("N0")</td>
                            <td>@item.TotalRoomPrice?.ToString("N0")</td>
                            <td>@item.TotalServicePrice?.ToString("N0")</td>
                            <td>@item.TotalExtraPrice?.ToString("N0")</td>
                            <td>@StatusHelper.DisplayRoomBookingStatus(item.Status)</td>
                            <td>@item.CreatedTime?.ToString("dd-MM-yyyy hh:mm:ss")</td>
                            @if (item.Status == Domain.Enums.RoomBookingStatus.PAID)
                            {
                                <td>
                                    <button class="btn btn-gold" onclick="_feedback_send.showPopup('@item.Id')">Đánh giá</button>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-secondary">Không đủ điều kiện thao tác</span>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="13">Quý khách chưa có đặt bất kì phòng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="ratingPopup" class="popup-overlay">
            <div class="popup">
                <h5 class="popup-title">Đánh giá phòng</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tên phòng</th>
                                <th>Đánh giá</th>
                                <th>Nội dung</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="roomTable">
                            <!-- Rows will be dynamically added here -->
                        </tbody>
                    </table>
                </div>
                <div class="popup-buttons text-end">
                    <button class="btn btn-outline-secondary btn-lg me-3" onclick="_feedback_send.closePopup()">Hủy</button>
                    <button class="btn btn-success btn-lg" onclick="_feedback_send.submitAllFeedback()">Gửi tất</button>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("BookingHistory", new { pageIndex = 1, pageSize = Model.PageSize })">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                    </li>
                    @for (var i = 1; i <= Model.totalPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("BookingHistory", new { pageIndex = i, pageSize = Model.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.totalPage ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("BookingHistory", new { pageIndex = Model.totalPage, pageSize = Model.PageSize })">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
    <div class="mt-5 pt-5 border-top">
        <h4 class="mb-5 fs-3 fw-bold">🧳 5+ Mẹo chọn phòng có view đẹp cho chuyến du lịch đáng nhớ</h4>

        <!-- Mẫu tip: lặp lại 5 lần -->
        <div class="row mb-5 align-items-center">
            <div class="col-md-6">
                <img src="~/img/banner3.jpg" class="w-100 rounded shadow" alt="Đọc kỹ mô tả phòng">
            </div>
            <div class="col-md-6 ps-md-5 mt-3 mt-md-0">
                <h5 class="fw-semibold mb-2">📌 1. Đọc kỹ phần mô tả phòng</h5>
                <p class="mb-2">Đừng bỏ qua phần mô tả, vì đó là nơi chứa nhiều thông tin quan trọng. Hãy tìm những cụm như <code>view biển</code>, <code>hướng núi</code>, <code>ban công riêng</code>, <code>cửa sổ lớn</code>. Một số khách sạn để chữ nhỏ hoặc để ở cuối, bạn cần để ý kỹ để tránh chọn nhầm phòng nhìn ra tường hoặc nhà dân bên cạnh.</p>
                <p>Ngoài ra, để ý kích thước phòng: diện tích nhỏ dưới 18m² thường ít có không gian mở hoặc ban công.</p>
            </div>
        </div>

        <div class="row mb-5 align-items-center flex-md-row-reverse">
            <div class="col-md-6">
                <img src="~/img/bn3.jpg" class="w-100 rounded shadow" alt="Phòng tầng cao">
            </div>
            <div class="col-md-6 pe-md-5 mt-3 mt-md-0">
                <h5 class="fw-semibold mb-2">🖼️ 2. Ưu tiên phòng ở tầng cao</h5>
                <p class="mb-2">Phòng tầng cao thường mang lại trải nghiệm yên tĩnh, ít bị ảnh hưởng bởi tiếng ồn từ đường phố hay các khu sinh hoạt chung. Đặc biệt, view ở tầng cao thường bao quát hơn và không bị che bởi cây cối hoặc các toà nhà thấp tầng.</p>
                <p>Nếu khách sạn không hiển thị tầng, hãy liên hệ trực tiếp để xác nhận.</p>
            </div>
        </div>

        <div class="row mb-5 align-items-center">
            <div class="col-md-6">
                <img src="~/img/banner3.jpg" class="w-100 rounded shadow" alt="Ảnh thật từ khách hàng">
            </div>
            <div class="col-md-6 ps-md-5 mt-3 mt-md-0">
                <h5 class="fw-semibold mb-2">📍 3. Tham khảo ảnh thật từ khách trước</h5>
                <p class="mb-2">Ảnh do khách từng lưu trú đăng lên thường phản ánh chính xác tình trạng thực tế của phòng: từ view, ánh sáng, cách bố trí đến cả độ mới của nội thất. Bạn có thể tìm ảnh thật ở phần đánh giá của khách hoặc các nhóm du lịch trên mạng xã hội.</p>
                <p>Ảnh chụp vào buổi sáng sớm hoặc chiều muộn thường cho bạn cái nhìn rõ nhất về ánh sáng trong phòng.</p>
            </div>
        </div>

        <div class="row mb-5 align-items-center flex-md-row-reverse">
            <div class="col-md-6">
                <img src="~/img/bn2.jpg" class="w-100 rounded shadow" alt="Ghi chú khi đặt phòng">
            </div>
            <div class="col-md-6 pe-md-5 mt-3 mt-md-0">
                <h5 class="fw-semibold mb-2">📨 4. Ghi chú rõ ràng khi đặt phòng</h5>
                <p class="mb-2">Rất nhiều khách bỏ qua mục ghi chú khi đặt phòng, nhưng đây là cơ hội để bạn yêu cầu cụ thể như “phòng tầng cao”, “hướng biển”, “tránh gần thang máy”. Khách sạn thường sắp xếp theo thứ tự ưu tiên yêu cầu nếu phòng còn.</p>
                <p>Đối với resort hoặc villa, ghi chú sẽ giúp bạn tránh các phòng khuất trong khuôn viên, không có view.</p>
            </div>
        </div>

        <div class="row mb-5 align-items-center">
            <div class="col-md-6">
                <img src="~/img/banner1.jpg" class="w-100 rounded shadow" alt="Check-in sớm chọn phòng đẹp">
            </div>
            <div class="col-md-6 ps-md-5 mt-3 mt-md-0">
                <h5 class="fw-semibold mb-2">🕒 5. Đến sớm để chọn phòng đẹp hơn</h5>
                <p class="mb-2">Nếu bạn check-in sớm trong khung giờ khách sạn bắt đầu nhận khách (thường từ 14h), khả năng cao bạn sẽ được lựa chọn trong số các phòng còn trống – trong đó có nhiều phòng view đẹp.</p>
                <p>Một số khách sạn còn linh hoạt nâng hạng nếu bạn đến sớm, lễ tân dễ hỗ trợ khi chưa bị quá tải.</p>
            </div>
        </div>
    </div>


</div>

@section scripts {
    <script asp-append-version="true" src="~/module/feedback_send.js"></script>
}