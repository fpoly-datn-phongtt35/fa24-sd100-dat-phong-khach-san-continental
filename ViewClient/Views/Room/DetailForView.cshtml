@using Domain.DTO.Room
@using Domain.Enums
@using ViewClient.Models.DTO
@using ViewClient.Views.Shared

@model RoomDetailViewModel
@{
    var averageRatings = (Dictionary<Guid, RoomRatingDto>)ViewBag.AverageRatings;
    var rating = averageRatings.ContainsKey(Model.Room.Id) ? averageRatings[Model.Room.Id] : new RoomRatingDto();
}
<style>
    .room-main {
        height: 100%;
        min-height: 300px;
        padding: 3px;
    }

        .room-main img {
            width: 644px;
            height: 371px;
            object-fit: cover;
            display: block;
            border-radius: 15px 0 0 15px;
        }

    .room-grid-small img {
        width: 320px;
        height: 184px;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        flex-shrink: 0; /* Ngăn không cho ảnh bị co lại */
    }


    .room-grid-small {
        padding: 2px;
        height: 100%;
        position: relative;
    }

    .room-grid-wrapper {
        height: 100%;
        min-height: 300px;
    }

    .luxury-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: none;
    }

    .text-muted{
        font-family: 'Montserrat', sans-serif;
    }

    .room-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 600; /* hoặc 700 nếu bạn muốn đậm hơn */

        color: #333;
    }

    body {
        background-color: #f1f2f3;
    }

    .room-title2 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        color: black;
    }

    .room-title1 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 400;
        color: black;
    }

    .amenity-badge {
        font-family: 'Montserrat', sans-serif;
        display: inline-block;
        padding: 6px 12px;
        border: 1px solid #ddd;
        border-radius: 999px;
        background-color: #fff;
        color: #333;
        font-size: 14px;
        font-weight: 700;
    }

</style>



<div class="container py-4">
    <div class=" mb-4">
        <h6 class="fw-bold room-title">Continental > Chi tiết phòng > @Model.Room.Name</h6>
    </div>


    @{
        var totalImages = Model.Room.Images.Count;
        var extraCount = totalImages - 5;
    }
    <div style="max-height:353px" class="my-1">
        @if (Model.Room.Images != null && Model.Room.Images.Any())
        {
            <div class="row g-0">
                <!-- Ảnh lớn bên trái -->
                <div class="col-md-6">
                    <div class="room-main shadow-soft h-100">
                        <a href="@Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[0].Image)}")"
                           class="glightbox"
                           data-gallery="room-gallery">
                            <img src="@Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[0].Image)}")"
                                 alt="Ảnh chính"
                                 onerror="this.onerror=null; this.src='/images/default.jpg';" />
                        </a>
                    </div>
                </div>

                <!-- Ảnh nhỏ chia làm 2x2 bên phải -->
                <div class="col-md-6">
                    <div class="room-grid-wrapper">
                        @for (int row = 0; row < 2; row++)
                        {
                            <div class="row g-0 flex-fill">
                                @for (int col = 0; col < 2; col++)
                                {
                                    int index = 1 + row * 2 + col;
                                    if (index < totalImages)
                                    {
                                        var imageUrl = Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[index].Image)}");
                                        string borderRadius = "";

                                        if (index == 2) borderRadius = "border-top-right-radius: 15px;";
                                        if (index == 4) borderRadius = "border-bottom-right-radius: 15px;";
                                        var isLast = (index == 4 && extraCount > 0);

                                        <div class="col-6 room-grid-small">
                                            <a href="@imageUrl" class="glightbox d-block h-100 " data-gallery="room-gallery">
                                                <img src="@imageUrl"
                                                     alt="Ảnh phụ"
                                                     onerror="this.onerror=null; this.src='/images/default.jpg';"
                                                     style="@borderRadius" />

                                                @if (isLast)
                                                {
                                                    <div class="position-absolute" style="
                                                        bottom: 6px;
                                                        right: 10px;
                                                        background-color: rgba(255, 255, 255, 0.9);
                                                        color: #000;
                                                        padding: 4px 10px;
                                                        border-radius: 20px;
                                                        font-size: 0.9rem;
                                                        font-weight: 600;
                                                        display: flex;
                                                        align-items: center;
                                                        gap: 4px;
                                                        box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                                                        +@extraCount
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                                            <path d="M14 4v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4h12zm-1 0H3v9a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4zM8 1a2 2 0 0 1 2 2H6a2 2 0 0 1 2-2z" />
                                                        </svg>
                                                    </div>
                                                }

                                            </a>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- Ẩn các ảnh còn lại để lightbox nhận diện -->
                        @for (int i = 5; i < totalImages; i++)
                        {
                            var imageUrl = Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[i].Image)}");
                            <a href="@imageUrl" class="glightbox d-none" data-gallery="room-gallery"></a>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">Không có hình ảnh</p>
        }
    </div>


    <div class="d-flex justify-content-between align-items-center mt-4">
        <h1 class="room-title mb-0">@Model.Room.Name</h1>
        <div class="rating text-end">
            @rating.AverageRating
            <i style="color: orange;" class="bi bi-star-fill"></i>
            <small>(@rating.TotalReviews đánh giá)</small>
        </div>
    </div>
    <p style="font-size: 1.1rem; color: #555;" class="room-title2">
        Khách sạn
        <i style="color: orange;" class="bi bi-star-fill"></i>
        <i style="color: orange;" class="bi bi-star-fill"></i>
    </p>
    <div class="row my-3 d-flex align-items-stretch">
        <!-- Cột trái -->
        <div class="col-md-8">
            <div class="luxury-card h-100">
                <div class="row my-3">
                    <div class="mb-3 col-md-7">
                        <h5 class="room-title">Mô tả của phòng</h5>
                        @{
                            var description = Model.Room.Description ?? "";
                            var maxLength = 300; // Số ký tự tối đa trước khi "xem thêm"
                            var shortDescription = description.Length > maxLength ? description.Substring(0, maxLength) : description;
                            var isLong = description.Length > maxLength;
                        }
                        <div class="room-title1" id="descriptionText">
                            @Html.Raw(isLong ? shortDescription + "..." : description)
                        </div>

                        @if (isLong)
                        {
                            <a href="javascript:void(0)" id="toggleDescription" class="text-primary">Xem thêm</a>
                        }

                    </div>

                    <div class="col-md-5">
                        <h5 class="room-title">Tiện ích của phòng</h5>
                        @if (Model.Room.RoomType.AmenityRooms != null && Model.Room.RoomType.AmenityRooms.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var amenityRoom in Model.Room.RoomType.AmenityRooms.Where(a => a.Status == EntityStatus.Active))
                                {
                                    <span class="amenity-badge">
                                        @amenityRoom.Amenity.Name (@amenityRoom.Amount)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Phòng này không có tiện ích nào.</p>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- Cột phải -->
        <div class="col-md-4">
            <div class="luxury-card h-10">
                <h5 class="room-title mb-3 my-3">Thông tin phòng</h5>
                <p class="room-title2">Loại phòng: @Model.RoomType.Name</p>
                <p class="room-title2">Diện tích: @Model.Room.RoomSize m²</p>
                <p class="room-title2">Sức chứa: @Model.RoomType.MaximumOccupancy người</p>
                <p class="room-title2">
                    Giá:
                    <span class="text-danger fw-bold">
                        @Math.Round(Model.Room.Price ?? 0).ToString("N0") VNĐ/đêm
                    </span>
                </p>
            </div>
        </div>
    </div>

    <input type="hidden" id="Id_Room" value="@Model.Room.Id" />
    <div class="luxury-card my-4">
        <h5 class="room-title"><i class=" fa-solid fa-comments"></i> Phản hồi từ khách hàng</h5>
        <div class="p-3 bg-light rounded room-title1">
            <div id="ListCMT"></div>
        </div>
    </div>
</div>
@section scripts {
    <script asp-append-version="true" src="~/module/feeback.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const lightbox = GLightbox({
            selector: '.glightbox'
        });
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const fullText = `@Html.Raw(description.Replace("`", "\\`").Replace(Environment.NewLine, "<br/>"))`;
        const shortText = `@Html.Raw(shortDescription.Replace("`", "\\`").Replace(Environment.NewLine, "<br/>"))...`;

        const desc = document.getElementById('descriptionText');
        const toggleBtn = document.getElementById('toggleDescription');
        let expanded = false;

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                expanded = !expanded;
                desc.innerHTML = expanded ? fullText : shortText;
                toggleBtn.innerText = expanded ? 'Thu gọn' : 'Xem thêm';
            });
        }
    });
</script>
