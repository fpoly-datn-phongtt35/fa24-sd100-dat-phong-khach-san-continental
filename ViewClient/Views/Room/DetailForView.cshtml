@using Domain.Enums
@using ViewClient.Models.DTO
@using ViewClient.Views.Shared

@model RoomDetailViewModel

<style>
    body {
        background-color: #f4f4f4;
    }

    .gold-text {
        color: #c9a74f;
    }

    .luxury-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .carousel-item img {
        border-radius: 10px;
    }

    .btn-gold {
        background: #c9a74f;
        color: white;
        border-radius: 8px;
    }

        .btn-gold:hover {
            background: #b08c3e;
        }
</style>

<div class="container py-5">
    <div class="luxury-card mb-4">
        <h6 class="fw-bold gold-text">Contiental > Chi tiết phòng > @Model.Room.Name</h6>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div id="roomCarousel" class="carousel slide luxury-card" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (Model.Room.Images != null && Model.Room.Images.Any())
                    {
                        @for (int i = 0; i < Model.Room.Images.Count; i++)
                        {
                            var img = Model.Room.Images[i];
                            var imagePath = Url.Content($"~/images/{System.IO.Path.GetFileName(img.Image)}");
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@imagePath" class="d-block w-100" alt="Room Image" onerror="this.onerror=null; this.src='/images/default.jpg';" />
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Không có hình ảnh</p>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <div class="col-md-5">
            <div class="luxury-card">
                <h3 class="gold-text">Thông tin phòng</h3>
                <p><strong>Loại phòng:</strong> @Model.RoomType.Name</p>
                <p><strong>Diện tích:</strong> @Model.Room.RoomSize m²</p>
                <p><strong>Sức chứa:</strong> @Model.RoomType.MaximumOccupancy người</p>
                <p><strong>Giá:</strong> <span class="text-danger fw-bold">@Math.Round(Model.Room.Price ?? 0).ToString("N0") VNĐ/đêm</span></p>
            </div>
        </div>
    </div>

    <div class="luxury-card my-4">
        <h4 class="gold-text">Mô tả</h4>
        <p>@Model.Room.Description</p>
    </div>

    <div class="luxury-card my-4">
        <h4 class="gold-text">Tiện ích</h4>
        @if (Model.Room.RoomType.AmenityRooms != null && Model.Room.RoomType.AmenityRooms.Any())
        {
            <div class="d-flex flex-wrap">
                @foreach (var amenityRoom in Model.Room.RoomType.AmenityRooms.Where(a => a.Status == EntityStatus.Active))
                {
                    <div class="d-flex align-items-center m-2">
                        <i class="fa-solid fa-check amenity-icon"> </i>
                        <span> <strong> @amenityRoom.Amenity.Name:</strong> @amenityRoom.Amount</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Phòng này không có tiện ích nào.</p>
        }
    </div>


    <div class="luxury-card my-4">
        <h4 class="gold-text"><i class="fa-solid fa-comments"></i> Phản hồi từ khách hàng</h4>
        <div class="p-3 bg-light rounded">
            <div id="ListCMT"></div>
        </div>
    </div>
</div>
@section scripts {
    <script asp-append-version="true" src="~/module/feeback.js"></script>
}