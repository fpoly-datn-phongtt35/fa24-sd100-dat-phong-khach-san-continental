@using Domain.Enums
@using ViewClient.Models.DTO
@using ViewClient.Views.Shared

@model RoomDetailViewModel

@{
    ViewData["Title"] = "Details";
    bool isUserLoggedIn = Context.Session.GetString("UserName") != null;
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-gold">@Html.DisplayFor(model => model.Room.Name)</h2>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-light">Quay lại</a>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="luxury-carousel">
                @if (Model.Room.Images != null && Model.Room.Images.Any())
                {
                    <div id="roomImageCarousel" class="carousel slide" data-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.Room.Images.Count; i++)
                            {
                                var img = Model.Room.Images[i];
                                var imagePath = Url.Content($"/View/wwwroot/images/{img}");
                                var activeClass = (i == 0) ? "active" : "";

                                <div class="carousel-item @activeClass">
                                    <img src="@imagePath" class="d-block w-100 luxury-img" alt="" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                }
                else
                {
                    <p>Không có hình ảnh</p>
                }
            </div>
        </div>

        <div class="col-md-5">
            <div class="luxury-card p-4">
                <h3 class="text-gold">Thông tin phòng</h3>
                <p><strong>Diện tích:</strong> @Html.DisplayFor(model => model.Room.RoomSize) m²</p>
                <p><strong>Giá:</strong> @Math.Round(Model.Room.Price ?? 0) VNĐ/đêm</p>
                <p><strong>Địa chỉ:</strong> @Html.DisplayFor(model => model.Room.Address)</p>
                <p><strong>Mô tả:</strong> @Html.DisplayFor(model => model.Room.Description)</p>
                <hr>
                <h4 class="text-gold">Tiện ích</h4>
                @if (Model.Room.RoomType.AmenityRooms != null && Model.Room.RoomType.AmenityRooms.Any())
                {
                    <ul>
                        @foreach (var amenityRoom in Model.Room.RoomType.AmenityRooms.Where(amenityRoom => amenityRoom.Status == EntityStatus.Active))
                        {
                            <li><strong>@amenityRoom.Amenity.Name:</strong> @amenityRoom.Amount</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Phòng này không có tiện ích nào.</p>
                }
                <button class="btn btn-gold mt-3" data-bs-toggle="modal" data-bs-target="#bookingConfirmationModal">Đặt phòng ngay</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận -->
<div class="modal fade" id="bookingConfirmationModal" tabindex="-1" aria-labelledby="bookingConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content luxury-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold">Xác nhận đặt phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Tên phòng:</strong> @Model.Room.Name</p>
                <p><strong>Ngày nhận phòng:</strong> <span id="modalCheckIn"></span></p>
                <p><strong>Ngày trả phòng:</strong> <span id="modalCheckOut"></span></p>
                <p><strong>Tổng tiền:</strong> <span id="modalTotalPrice"></span> VNĐ</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-gold">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<script>
    var isUserLoggedIn = @isUserLoggedIn.ToString().ToLower();
    var roomId = '@Model.Room.Id';
    var roomPrice = '@Model.Room.Price';
    var bookingUrl = '@Url.Action("RoomBooking", "RoomBooking")';
</script>
@section scripts {
    <script asp-append-version="true" src="~/module/roomBooking.js"></script>
}
