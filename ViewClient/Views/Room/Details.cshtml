@using Domain.Enums
@using System.Security.Claims
@using ViewClient.Models.DTO
@using ViewClient.Views.Shared

@model RoomDetailViewModel

@{
    ViewData["Title"] = "Details";
    bool isUserLoggedIn = Context.User.Identity.IsAuthenticated;
}
<style>
    .text-gold {
        color: #c59d5f;
    }

    .btn-gold {
        background-color: #c59d5f;
        color: white;
        border: none;
        transition: 0.3s ease;
    }

        .btn-gold:hover {
            background-color: #a88042;
            transform: scale(1.05);
        }

    .luxury-img {
        object-fit: cover;
        height: 450px;
        border-radius: 10px;
        transition: transform 0.5s ease;
    }

        .luxury-img:hover {
            transform: scale(1.02);
        }

    .luxury-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: ">";
        padding: 0 0.5rem;
    }

    .room-main {
        height: 100%;
        min-height: 300px;
        padding: 3px;
    }

        .room-main img {
            width: 644px;
            height: 371px;
            object-fit: cover;
            display: block;
            border-radius: 15px 0 0 15px;
        }

    .room-grid-small img {
        width: 320px;
        height: 184px;
        object-fit: cover;
        display: block;
        border-radius: 0px;
        flex-shrink: 0; /* Ngăn không cho ảnh bị co lại */
    }

    .room-grid-small {
        padding: 2px;
        height: 100%;
        position: relative;
    }

    .room-grid-wrapper {
        height: 100%;
        min-height: 300px;
    }
</style>

<!-- Carousel -->
@{
    var totalImages = Model.Room.Images.Count;
    var extraCount = totalImages - 5;
}
<div class="container mt-4 shadow pt-2 pb-2 rounded-3">
    @if (Model.Room.Images != null && Model.Room.Images.Any())
    {
        <div class="row g-0">
            <!-- Ảnh lớn bên trái -->
            <div class="col-md-6">
                <div class="room-main shadow-soft h-100">
                    <a href="@Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[0].Image)}")"
                       class="glightbox"
                       data-gallery="room-gallery">
                        <img src="@Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[0].Image)}")"
                             alt="Ảnh chính"
                             onerror="this.onerror=null; this.src='/images/default.jpg';" />
                    </a>
                </div>
            </div>

            <!-- Ảnh nhỏ chia làm 2x2 bên phải -->
            <div class="col-md-6">
                <div class="room-grid-wrapper">
                    @for (int row = 0; row < 2; row++)
                    {
                        <div class="row g-0 flex-fill">
                            @for (int col = 0; col < 2; col++)
                            {
                                int index = 1 + row * 2 + col;
                                if (index < totalImages)
                                {
                                    var imageUrl = Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[index].Image)}");
                                    string borderRadius = "";

                                    if (index == 2) borderRadius = "border-top-right-radius: 15px;";
                                    if (index == 4) borderRadius = "border-bottom-right-radius: 15px;";
                                    var isLast = (index == 4 && extraCount > 0);

                                    <div class="col-6 room-grid-small">
                                        <a href="@imageUrl" class="glightbox d-block h-100 " data-gallery="room-gallery">
                                            <img src="@imageUrl"
                                                 alt="Ảnh phụ"
                                                 onerror="this.onerror=null; this.src='/images/default.jpg';" style="@borderRadius" />
                                            @if (isLast)
                                            {
                                                <div class="position-absolute" style="
    bottom: 6px;
    right: 10px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #000;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
                                                    +@extraCount
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M14 4v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4h12zm-1 0H3v9a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4zM8 1a2 2 0 0 1 2 2H6a2 2 0 0 1 2-2z" />
                                                    </svg>
                                                </div>
                                            }

                                        </a>
                                    </div>
                                }
                            }
                        </div>
                    }

                    <!-- Ẩn các ảnh còn lại để lightbox nhận diện -->
                    @for (int i = 5; i < totalImages; i++)
                    {
                        var imageUrl = Url.Content($"~/images/{System.IO.Path.GetFileName(Model.Room.Images[i].Image)}");
                        <a href="@imageUrl" class="glightbox d-none" data-gallery="room-gallery"></a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">Không có hình ảnh</p>
    }
</div>

<div class="container py-4 ps-0 pe-0">
    <input id="Id_Room" value="@Model.Room.Id" style="display:none" />

    <div class="container">
        <h5 class="fw-bold" style="font-family: 'Montserrat', sans-serif; font-weight: lighter; font-size: 1rem; color: #666; text-transform: uppercase; margin-bottom: 20px;">Continental - Đơn đặt phòng - @Html.DisplayFor(model => model.Room.Name)</h5>
    </div>
    <!-- Main Content -->
    <div class="">
        <div class="container p-0 d-flex">
            <div class="luxury-card me-2" style="width: 70%">
                <div class="">
                    <div class="card-title h5 mb-3">@Model.Room.Name</div>
                    <p><i class="fa-regular fa-clock"></i> Giờ nhận phòng: <strong id="checkIn">Từ 14:00</strong></p>
                    <p><i class="fa-regular fa-clock"></i> Giờ trả phòng: <strong id="checkOut">Trước 12:00</strong></p>
                    <p>Giá: @Math.Round(Model.Room.Price ?? 0) VNĐ/đêm</p>

                    @if (!isUserLoggedIn)
                    {
                        <h6>Thông tin cá nhân:</h6>
                        <div class="row">
                            <div class="col-6">
                                <label for="firstName">Họ</label>
                                <input type="text" class="form-control" id="firstName" placeholder="Nhập họ">
                            </div>
                            <div class="col-6">
                                <label for="lastName">Tên</label>
                                <input type="text" class="form-control" id="lastName" placeholder="Nhập tên">
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <label for="email">Email</label>
                                <input type="email" class="form-control" id="email" placeholder="Nhập email" required>
                            </div>
                            <div class="col-6">
                                <label for="phone">Số điện thoại</label>
                                <input type="text" class="form-control" id="phone" placeholder="Nhập số điện thoại" required>
                            </div>
                        </div>
                    }

                    <h6 class="mt-3">Dịch vụ thêm:</h6>
                    <div class="service-list" style="max-height: 200px; overflow-y: auto;">
                        @if (Model.Services != null && Model.Services.Any())
                        {
                            foreach (var service in Model.Services)
                            {
                                <div class="form-check d-flex align-items-center mb-2">
                                    <input class="form-check-input service-checkbox" type="checkbox" value="@service.Id" id="service_@service.Id">
                                    <label class="form-check-label flex-grow-1" for="service_@service.Id">
                                        <strong>@service.Name</strong> - <span style="color: green;" data-price="@service.Price">
                                            @(Math.Round(@service.Price).ToString("N0")) VNĐ
                                        </span> / @(service.UnitName)
                                    </label>
                                    <input type="number" class="form-control service-quantity" id="quantity_@service.Id" min="1" value="1" style="width: 80px;">
                                </div>
                            }
                        }
                        else
                        {
                            <p>Không có dịch vụ nào hiện có.</p>
                        }
                    </div>

                    <hr />
                    <div style="text-align: end;">
                        <p><strong>Đặt cọc:</strong> <span id="depositPayment">0 VNĐ</span></p>
                        <p><strong>Tiền phòng:</strong> <span id="totalRoomPayment">0 VNĐ</span></p>
                        <p><strong>Tiền dịch vụ:</strong> <span id="totalServicePayment">0 VNĐ</span></p>
                        <p><strong>Tổng tiền sau khi đặt cọc:</strong> <span id="totalPrice">0 VNĐ</span></p>
                    </div>
                </div>
                <div class="modal-footer">
                    @* <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button> *@
                    <button type="button" class="btn btn-dark" id="confirmBookingButton" style="">Đặt phòng</button>
                </div>
            </div>
            <!-- Room Info -->
            <div class="luxury-card" style="width:30%">
                <div class=" rounded-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        @* <h3 class="text-gold fw-bold mb-4">Thông tin phòng</h3> *@

                        <ul class="list-unstyled text-dark fs-6 lh-lg mb-0">
                            <li><strong>Loại phòng:</strong> @Html.DisplayFor(model => model.RoomType.Name)</li>
                            <li><strong>Diện tích:</strong> @Html.DisplayFor(model => model.Room.RoomSize) m²</li>
                            <li><strong>Sức chứa tối đa:</strong> @Html.DisplayFor(model => model.RoomType.MaximumOccupancy) người</li>
                        </ul>
                    </div>

                    @*  <div class="text-end mt-4">
                        <button class="btn btn-gold px-4 py-2 shadow-sm" id="booking" data-bs-toggle="modal" data-bs-target="#bookingModal">
                            Đặt phòng ngay
                        </button>
                    </div> *@
                </div>
            </div>
        </div>
    </div>

    <!-- Mô tả -->
    <section class="mt-5">
        <div class="bg-light border-start border-5 border-warning rounded-4 shadow-sm px-4 py-5">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-info-circle-fill text-warning fs-4 me-2"></i>
                <h4 class="fw-bold m-0" style="font-family: 'Montserrat', sans-serif; font-weight: lighter; font-size: 1rem; color: #666; text-transform: uppercase; margin-bottom: 20px; padding-top: 20px">Mô tả</h4>
            </div>
            <p class="text-dark fs-6" style="line-height: 1.7;">
                @Html.DisplayFor(model => model.Room.Description)
            </p>
        </div>
    </section>

    <!-- Tiện ích -->
    <section class="mt-4 mb-5">
        <div class="bg-light border-start border-5 border-warning rounded-4 shadow-sm px-4 py-5">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-stars text-warning fs-4 me-2"></i>
                <h4 class="fw-bold m-0" style="font-family: 'Montserrat', sans-serif; font-weight: lighter; font-size: 1rem; color: #666; text-transform: uppercase; margin-bottom: 20px; padding-top: 20px">Tiện ích</h4>
            </div>

            @if (Model.Room.RoomType.AmenityRooms != null && Model.Room.RoomType.AmenityRooms.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var amenityRoom in Model.Room.RoomType.AmenityRooms.Where(ar => ar.Status == EntityStatus.Active))
                    {
                        <div class="col">
                            <div class="d-flex align-items-start bg-white p-3 rounded shadow-sm h-100">
                                <i class="bi bi-check2-circle text-success fs-5 me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1 fw-semibold">@amenityRoom.Amenity.Name</h6>
                                    <p class="mb-0 text-muted small">Số lượng: @amenityRoom.Amount</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted fst-italic">Phòng này không có tiện ích nào.</p>
            }
        </div>
    </section>
</div>

<div class="container luxury-card my-4">
    <h4 class="" style="font-family: 'Montserrat', sans-serif; font-weight: lighter; font-size: 1rem; color: #666; text-transform: uppercase; margin-bottom: 20px; padding-top: 20px"><i class="fa-solid fa-comments"></i> Phản hồi từ khách hàng</h4>
    <div class="p-3 bg-light rounded">
        <div id="ListCMT"></div>
    </div>
</div>
@* <div class="modal fade" id="bookingModal" data-bs-keyboard="false" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">

    </div>
</div> *@
<div class="modal fade" id="bookingConfirmationModal" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="bookingConfirmationModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingConfirmationModalLabel">Xác nhận đặt phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Tên phòng:</strong> <h3 id="modalRoomName">Deluxe Room</h3></p>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="modalCheckIn" class="form-label"><strong>Ngày nhận phòng:</strong></label>
                    </div>
                    <div class="col-6">
                        <input type="text" id="modalCheckIn" name="checkIn" class="form-control" disabled>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="modalCheckOut" class="form-label"><strong>Ngày trả phòng:</strong></label>
                    </div>
                    <div class="col-6">
                        <input type="text" id="modalCheckOut" name="checkOut" class="form-control" disabled>
                    </div>
                </div>

                <p><strong>Dịch vụ đã chọn:</strong> <span id="modalServices" class="text-muted">Không có dịch vụ nào</span></p>
                <p><strong>Tiền đặt cọc:</strong> <span id="modalDeposit" class="highlight-text">0 VNĐ</span></p>
                <p><strong>Tổng tiền:</strong> <span id="modalTotalPrice" class="highlight-text">0 VNĐ</span> (đã trừ tiền đặt cọc)</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="confirmBooking">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="container my-4">
    <!-- Block: Vị trí và Câu hỏi thường gặp -->
    <div class="bg-light rounded-3 shadow-sm p-4 my-5">
        <div class="row">
            <!-- Map -->
            <div class="col-md-6 mb-4 mb-md-0">
                <h5 class="fw-bold">Vị trí khách sạn</h5>
                <p class="text-muted mb-3"><i class="fas fa-map-marker-alt me-2 text-danger"></i>Hai Bà Trưng, Hà Nội</p>
                <div class="ratio ratio-4x3 rounded-3 overflow-hidden">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.246546543672!2d105.85252957509654!3d21.02277878817761!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab909d2b9e01%3A0x96a307b1b9c41f79!2zSGFpIELDoCBC4bqvIFRyw6xuaCwgSG_DoG5nIE1haSwgSG_DoG5vaSBLw70sIFZpZXRuYW0!5e0!3m2!1svi!2s!4v1649823605976!5m2!1svi!2s"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <!-- FAQ -->
            <div class="col-md-6">
                <!-- FAQ mở rộng -->
                <h5 class="fw-bold">Câu hỏi thường gặp</h5>
                <div class="accordion mt-3" id="faqAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q1">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#a1">
                                Thời gian nhận và trả phòng là khi nào?
                            </button>
                        </h2>
                        <div id="a1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Nhận phòng từ 14:00 và trả phòng trước 12:00 hôm sau.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q2">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a2">
                                Có chỗ để xe không?
                            </button>
                        </h2>
                        <div id="a2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Chúng tôi có chỗ để xe miễn phí ngay trong khuôn viên.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q3">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a3">
                                Có cho phép mang thú cưng không?
                            </button>
                        </h2>
                        <div id="a3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Rất tiếc, chúng tôi không hỗ trợ mang theo thú cưng.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q4">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a4">
                                Đến muộn bao lâu thì đơn đặt phòng bị hủy?
                            </button>
                        </h2>
                        <div id="a4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                <p><strong>Tùy thuộc vào lượng khách có đông hay không:</strong></p>
                                <ol class="mt-2">
                                    <li>
                                        Nếu số lượng khách không quá đông và khách sạn vẫn còn quỹ phòng để đáp ứng,
                                        đơn của bạn sẽ được muộn tối đa <strong>5 tiếng</strong>.
                                    </li>
                                    <li class="mt-2">
                                        Trong trường hợp khách quá đông, chúng tôi chỉ có thể chờ quý khách tối đa <strong>2 tiếng</strong>.
                                    </li>
                                </ol>
                            </div>
                        </div>

                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="q5">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a5">
                                Hủy phòng khi đã cọc có được hoàn cọc không?
                            </button>
                        </h2>
                        <div id="a5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Rất tiếc! Quý khách không thể nhận lại cọc.
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="container my-4">
    <div class="text-end mb-3">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">← Quay lại</a>
    </div>
</div>

<script>
    var isUserLoggedIn = @isUserLoggedIn.ToString().ToLower();
    var roomId = '@Model.Room.Id';
    var roomPrice = '@Model.Room.Price';
    var bookingUrl = '@Url.Action("RoomBooking", "RoomBooking")';
</script>
@section scripts {
    <script asp-append-version="true" src="~/module/roomBooking.js"></script>
    <script asp-append-version="true" src="~/module/feeback.js"></script>
}
<style>
    .modal-content {
        border-radius: 10px;
        border: none;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }


    .modal-footer {
        border-top: 1px solid #dee2e6;
    }

    .modal-body p {
        margin-bottom: 10px;
    }

    .modal-body h3 {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .highlight-text {
        font-size: 18px;
        font-weight: bold;
        color: #d9534f;
    }

    .form-control[disabled] {
        background-color: #e9ecef;
        color: #495057;
        border: none;
        font-weight: bold;
        text-align: right;
    }


    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #545b62;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
<script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const lightbox = GLightbox({
            selector: '.glightbox'
        });
    });
</script>