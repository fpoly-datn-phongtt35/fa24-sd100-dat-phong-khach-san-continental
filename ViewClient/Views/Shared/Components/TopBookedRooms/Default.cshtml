@using Domain.DTO.Room
@model List<TopBookedRoom>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

<style>
    .room-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        justify-items: center;
    }

    @@media (max-width: 992px) {
        .room-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .room-grid {
            grid-template-columns: 1fr;
        }
    }

    .hotel-info-section {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 15px;
        font-family: Arial, sans-serif;
    }

        .hotel-info-section h4 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 500;
            font-size: 1.1rem;
            text-transform: uppercase;
            margin-bottom: 40px;
        }

        .hotel-info-section ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .hotel-info-section li {
            display: flex;
            align-items: flex-start;
            margin-bottom: 30px;
            font-size: 0.9rem;
        }

            .hotel-info-section li i {
                width: 20px;
                margin-right: 10px;
                font-size: 1rem;
            }

    .amenities-columns, .info-columns {
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .amenities-columns .col-md-4,
        .info-columns .col-md-4 {
            margin-bottom: 20px;
        }
    }

    .map-section {
        background-color: #ffffff;
        padding: 60px 0;
        font-family: Arial, sans-serif;
        width: 100%;
    }

    .map-section .container {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 0 15px;
    }

    .map-section .location-info {
        max-width: 400px;
        color: black;
    }

    .map-section h2 {
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        font-size: 2rem;
        text-transform: uppercase;
        margin-bottom: 20px;
        color: black;
    }

    .map-section p {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 20px;
        color: black;
    }

    .map-section .map-container {
        width: 60%;
        height: 400px;
        border-radius: 15px;
        overflow: hidden;
    }

    @@media (max-width: 768px) {
        .map-section .container {
            flex-direction: column;
            gap: 30px;
        }

        .map-section .location-info {
            max-width: 100%;
        }

        .map-section .map-container {
            width: 100%;
        }
    }
</style>

@if (Model != null && Model.Any())
{
    <div style="max-width: 1400px; margin: 0 auto; text-align: center; padding-bottom: 50px">
        <h3 style="font-family: 'Montserrat', sans-serif; font-weight: lighter; font-size: 1rem; color: #666; text-transform: uppercase; margin-bottom: 20px; padding-top: 20px">
            chào mừng đến với Continental
        </h3>
        <h1 style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 2.5rem; color: black; text-transform: uppercase; margin-bottom: 20px;">
            Continental – Đẳng Cấp & Sang Trọng
        </h1>
        <p style="font-family: 'Montserrat', sans-serif; font-weight: 400; font-size: 1rem; color: black; line-height: 1.5; max-width: 800px; margin: 0 auto;">
            Trải nghiệm đẳng cấp và sang trọng bậc nhất với hệ thống khách sạn **Continental**, nơi mỗi giây phút đều trở nên đáng nhớ. Chúng tôi cam kết mang đến dịch vụ hoàn hảo, tiện nghi cao cấp và không gian nghỉ dưỡng tuyệt vời dành cho quý khách.
        </p>
    </div>
    <div class="py-5" style="background-color: #f8f9fa;">
        <div style="max-width: 1400px; margin: 0 auto; padding-left: 15px; padding-right: 15px;">
            <h2 style="font-family: 'Montserrat', sans-serif; font-weight: 500; color: black; text-transform: uppercase; text-align: left;">
                TOP PHÒNG
            </h2>
            <hr style="width: 35%; border: 1px solid black; margin-bottom: 40px;" />
            <div class="room-grid">
                @foreach (var room in Model)
                {
                    <div style="width: 100%; height: 400px; border-radius: 15px; overflow: hidden; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); border: none;">
                        <a href="@Url.Action("DetailForViews", "Room", new { roomId = room.RoomId })" style="text-decoration: none; color: inherit;">
                            <img src="@Url.Content($"~/images/{System.IO.Path.GetFileName(room.RoomImages.FirstOrDefault() ?? "default.jpg")}")"
                                 style="width: 100%; height: 300px; object-fit: cover;"
                                 onerror="this.onerror=null; this.src='/images/default.jpg';" />

                            <div style="height: 100px; padding: 15px; display: flex; flex-direction: row; align-items: center; justify-content: space-between;">
                                <h5 style="font-size: 1.25rem; margin: 0;">@room.RoomName <i class="fa-solid fa-chevron-right ps-2"></i></h5>
                                <div style="background-color: #1C2526; border-radius: 18px; padding: 8px 15px; display: inline-flex; align-items: center;">
                                    <p style="margin: 0; color: white; font-size: 0.9rem; font-family: Arial, sans-serif;">
                                        <span style="color: white;">@room.RoomPrice.ToString("N0") đ</span>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="hotel-info-section">
        <!-- Featured Amenities On-Site -->
        <h4>Tiện ích khách sạn</h4>
        <div class="row amenities-columns">
            <div class="col-md-4">
                <ul>
                    <li><i class="fas fa-utensils"></i> Nhà hàng</li>
                    <li><i class="fas fa-wifi"></i> Wifi miễn phí</li>
                    <li><i class="fas fa-store"></i> Cửa hàng tiện lợi</li>
                </ul>
            </div>
            <div class="col-md-4">
                <ul>
                    <li><i class="fas fa-spa"></i> Dịch vụ Spa</li>
                    <li><i class="fas fa-coffee"></i> Trà và cafe</li>
                    <li><i class="fas fa-gift"></i> Cửa hàng lưu niệm</li>
                </ul>
            </div>
            <div class="col-md-4">
                <ul>
                    <li><i class="fas fa-briefcase"></i> Không gian họp</li>
                    <li><i class="fas fa-bicycle"></i> Thuê xe</li>
                    <li><i class="fas fa-phone"></i> Đánh thức</li>
                </ul>
            </div>
        </div>

        <!-- Hotel Information -->
        <h4>Thông tin</h4>
        <div class="row info-columns">
            <div class="col-md-4">
                <ul>
                    <li><i class="fa-regular fa-clock"></i>Giờ Check-in: 2:00 pm</li>
                    <li><i class="fa-regular fa-clock"></i>Giờ Check-out: 12:00 am</li>
                </ul>
            </div>
            <div class="col-md-4">
                <ul>
                    <li><i class="fa-solid fa-check"></i> Tuổi tối thiểu để Check In: 18</li>
                    <li><i class="fas fa-paw"></i> Chính sách thú cưng <br> Được phép. Tối đa 1 pet 1 phòng</li>
                </ul>
            </div>
            <div class="col-md-4">
                <ul>
                    <li><i class="fas fa-parking"></i> Bãi đỗ xe miễn phí</li>
                </ul>
            </div>
        </div>
    </div>

    <div style="background-color: #1C2526; padding: 50px 0; font-family: Arial, sans-serif; width: 100%;">
        <div style="max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 15px;">
            <div style="max-width: 400px; color: white;">
                <h2 style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 2rem; text-transform: uppercase; margin-bottom: 20px;">
                    DỊCH VỤ CAO CẤP
                </h2>
                <p style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">
                    Continental cung cấp không gian lưu trú sang trọng với đầy đủ tiện nghi hiện đại, nhà hàng cao cấp, hồ bơi ngoài trời, phòng gym, và dịch vụ chuyên nghiệp nhằm mang đến cho quý khách một kỳ nghỉ thoải mái và đáng nhớ
                </p>
                <a href="@Url.Action("GroupedServices", "Service")" style="background-color: #FFD700; color: black; border: none; padding: 10px 20px; border-radius: 25px; font-weight: bold; text-decoration: none; display: inline-block;">
                    KHÁM PHÁ
                </a>
            </div>

            <div style="width: 50%; height: auto; border-radius: 15px; overflow: hidden; display: flex; align-items: center;">
                <img src="~/img/sv1.jpg" style="width: 100%; height: 100%; object-fit: cover; object-position: center;" onerror="this.onerror=null; this.src='/images/default.jpg';" />
            </div>
        </div>
    </div>

    <!-- Updated Map Section with Swapped Positions -->
    <div class="map-section">
        <div class="container">
            <div class="map-container">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.8050743583894!2d105.73617257608893!3d21.040484080611822!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3134550ab1db2433%3A0x9febb50e17509deb!2zMTMgUC4gVHLhu4tuaCBWxINuIELDtCwgWHXDom4gUGjGsMahbmcsIE5hbSBU4burIExpw6ptLCBIw6AgTuG7mWksIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1745073291474!5m2!1svi!2s" width="800" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <div class="location-info">
                <h2 style="font-family: 'Montserrat', sans-serif; font-weight: 500; font-size: 2rem; text-transform: uppercase; margin-bottom: 20px;">
                    VỊ TRÍ
                </h2>
                <p style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">
                    Continental Hotel Hanoi<br>
                    13 Trịnh Văn Bô, phường Phương Canh, quận Nam Từ Liêm<br>
                    Sđt: +84 968458834
                </p>
            </div>
        </div>
    </div>
}