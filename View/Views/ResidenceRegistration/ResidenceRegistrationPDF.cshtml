@using Domain.DTO.Amenity
@using Domain.DTO.ResidenceRegistration
@using View.Views.Shared.Helper
@model Domain.DTO.Paging.ResponseData<Domain.DTO.ResidenceRegistration.ResidenceResponse>

@{
Layout = null;
}
<link href="@("http://" + Context.Request.Host.ToString() + "/StyleSheet.css")" rel="stylesheet" />
<h1>Danh sách tạm trú ngày @(ViewData["FilterDate"])</h1>

<table style="border-collapse: collapse; width: 100%;">
    <thead>
    <tr>
        <th style="border: 1px solid black;">Phòng</th>
        <th style="border: 1px solid black;">Khách</th>
        <th style="border: 1px solid black;">Ngày sinh</th>
        <th style="border: 1px solid black;">Giới tính</th>
        <th style="border: 1px solid black;">CCCD</th>
        <th style="border: 1px solid black;">SĐT</th>
        <th style="border: 1px solid black;">Checkin</th>
        <th style="border: 1px solid black;">Checkout</th>
    </tr>
    </thead>
    <tbody>
    @foreach (ResidenceResponse residence in Model.data)
    {
    <tr>
        <td style="border: 1px solid black; width: 10%; text-align: center">@residence.RoomName</td>
        <td style="border: 1px solid black; width: 15%; text-align: center">@residence.FullName</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.DateOfBirth.ToString("dd/MM/yyyy")</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.Gender</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.IdentityNumber</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.PhoneNumber</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.CheckInTime?.ToString("dd/MM/yyyy HH:mm")</td>
        <td style="border: 1px solid black; width: 12.5%; text-align: center">@residence.CheckOutTime?.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>
    @if ((Model.data.IndexOf(residence) + 1) % 2 == 0)
    {
    <tr style="page-break-after: always;"></tr>
    }
    }
    </tbody>
</table>

<style>
    .pdf-page-break {
        page-break-after: always;
    }
</style>

