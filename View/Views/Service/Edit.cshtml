@using Domain.Enums
@using View.Models.Service
@using View.Views.Shared.Helper
@model ServiceUpdateModel

<h2>Chỉnh sửa</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name">Tên</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="ModifiedTime" value="@DateTime.UtcNow" />

    <div class="form-group">
        <label asp-for="Description">Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price">Giá</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UnitId">Đơn vị</label>
        <select asp-for="UnitId" class="form-control" asp-items="@(new SelectList(ViewBag.Units, "Id", "Name", Model.UnitId))">
            <option value="">-- Chọn đơn vị --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="ServiceTypeId">Loại dịch vụ</label>
        <select asp-for="ServiceTypeId" class="form-control" asp-items="@(new SelectList(ViewBag.ServiceTypes, "Id", "Name", Model.ServiceTypeId))">
            <option value="">-- Select Service --</option>
        </select>
    </div>
    
    <div class="form-group">
        <label>Hình ảnh hiện tại</label>
        <div id="imagePreview" style="display: flex; flex-wrap: wrap; gap: 10px;">
            @if (Model.ExistingImages != null)
            {
                foreach (var img in Model.ExistingImages)
                {
                    <div style="position: relative; border: 1px solid #ddd; border-radius: 4px; padding: 5px;">
                        <img src="@img" style="width: 200px; height: 200px; object-fit: cover;" />
                        <button type="button" onclick="removeImage(this, '@img')" style="display: none; position: absolute; top: 5px; right: 5px; background: #444; color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 12px; line-height: 16px;">× Delete</button>
                    </div>
                }
            }
        </div>
    </div>

    <div class="form-group">
        <label>Thêm ảnh mới</label>
        <input type="file" id="imageUpload" name="NewImages" class="form-control" multiple />
    </div>


    <div class="form-group mb-3">
        <label asp-for="Status" class="control-label1">Trạng thái</label>
        <select asp-for="Status" class="form-select">
            <option value="">-- Chọn trạng thái --</option>
            @foreach (var status in Enum.GetValues(typeof(EntityStatus)))
            {
                var statusEnum = (EntityStatus)status;
                <option value="@((int)statusEnum)">
                    @StatusHelper.DisplayNameEntityStatus(statusEnum)
                </option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <script>
        function removeImage(button, imageUrl) {
            button.parentElement.remove();
            let input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'DeletedImages';
            input.value = imageUrl;
            document.querySelector('form').appendChild(input);
        }

        document.getElementById('imageUpload').addEventListener('change', function (event) {
            let imagePreview = document.getElementById('imagePreview');
            for (let file of event.target.files) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    let div = document.createElement("div");
                    div.style.position = "relative";
                    div.style.border = "1px solid #ddd";
                    div.style.borderRadius = "4px";
                    div.style.padding = "5px";
                    div.innerHTML = `<img src="${e.target.result}" style="width: 200px; height: 200px; object-fit: cover;" /><button type="button" onclick="this.parentElement.remove()" style="display: none; position: absolute; top: 5px; right: 5px; background: #444; color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 12px; line-height: 16px;">× Delete</button>`;
                    div.onmouseover = () => div.querySelector('button').style.display = 'block';
                    div.onmouseout = () => div.querySelector('button').style.display = 'none';
                    imagePreview.appendChild(div);
                };
                reader.readAsDataURL(file);
            }
        });

        document.querySelectorAll('#imagePreview > div').forEach(div => {
            div.onmouseover = () => div.querySelector('button').style.display = 'block';
            div.onmouseout = () => div.querySelector('button').style.display = 'none';
        });
    </script>
}