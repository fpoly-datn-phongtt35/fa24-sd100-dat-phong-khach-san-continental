@using Domain.Enums
@using View.Models.Service
@using View.Views.Shared.Helper
@model ServiceCreateViewModel
@{
    ViewData["Title"] = "Create Service";
}

<h2>Tạo mới dịch vụ</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="ServiceTypeId">Loại dịch vụ</label>
        <select required asp-for="ServiceTypeId" class="form-control" asp-items="@(new SelectList(ViewBag.ServiceTypes, "Id", "Name"))">
            <option value="">-- Chọn loại dịch vụ --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Name">Tên dịch vụ</label>
        <input required asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description">Mô tả</label>
        <textarea required asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price">Giá</label>
        <input required min="1" asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UnitId">Loại đơn vị</label>
        <select required asp-for="UnitId" class="form-control" asp-items="@(new SelectList(ViewBag.Units, "Id", "Name"))">
            <option value="">-- Chọn đơn vị --</option>
        </select>
    </div>
    @* <div class="form-group">
        <label asp-for="Images">Hình ảnh</label>
        <input required asp-for="Images" type="file" name="img" class="form-control" />
        <span asp-validation-for="Images" class="text-danger"></span>
    </div> *@
    <div class="form-group">
        <label>Hình ảnh</label>
        <input type="file" asp-for="Images" multiple class="form-control" />
    </div>

    <input type="hidden" asp-for="CreatedTime" value="@DateTime.UtcNow" />
    @* <input type="hidden" asp-for="CreatedBy" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" /> *@

    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
