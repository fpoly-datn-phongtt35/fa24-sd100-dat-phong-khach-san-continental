@using Domain.Enums
@using View.Models.Room
@model RoomUpdateViewModel
@{
    ViewData["Title"] = "Edit";
}

<h3>Chỉnh sửa phòng</h3>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name" class="control-label">Tên</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label">Giá Phòng</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label">Địa chỉ</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Mô tả</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomSize" class="control-label">Cỡ phòng</label>
                <input asp-for="RoomSize" class="form-control" />
                <span asp-validation-for="RoomSize" class="text-danger"></span>
            </div>

            <!-- Các trường khác -->
            @* <div class="form-group">
                <label asp-for="Images" class="control-label">Hình ảnh</label>
                <input type="file" name="imgFiles" class="form-control" multiple />
                <span asp-validation-for="Images" class="text-danger"></span>

            </div> *@
            
            <div class="form-group">
                <label asp-for="FloorId" class="control-label">Loại phòng</label>
                <select asp-for="FloorId" class="form-control">
                    <option value="">-- Chọn loại phòng --</option>
                    @foreach (var floor in ViewBag.Floors)
                    {
                        <option value="@floor.Id">@floor.Name</option>
                    }
                </select>
                <span asp-validation-for="RoomTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomTypeId" class="control-label">Loại phòng</label>
                <select asp-for="RoomTypeId" class="form-control">
                    <option value="">-- Chọn loại phòng --</option>
                    @foreach (var roomType in ViewBag.RoomTypes)
                    {
                        <option value="@roomType.Id">@roomType.Name</option>
                    }
                </select>
                <span asp-validation-for="RoomTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    @{
                        string[] status = (string[])Enum.GetNames(typeof(RoomStatus));
                    }
                    @foreach (string item in status)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="form-group" hidden>
                <label asp-for="ModifiedTime" class="control-label">Thời gian sửa</label>
                <input asp-for="ModifiedTime" class="form-control" />
                <span asp-validation-for="ModifiedTime" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Cập nhật" class="btn btn-warning" />
            </div>
            <div class="form-group">
                <label>Hình ảnh hiện tại</label>
                <div id="imagePreview" style="display: flex; flex-wrap: wrap; gap: 10px;">
                    @if (Model.ExistingImages != null)
                    {
                        foreach (var img in Model.ExistingImages)
                        {
                            <div style="position: relative; border: 1px solid #ddd; border-radius: 4px; padding: 5px;">
                                <img src="@img" style="width: 200px; height: 200px; object-fit: cover;" />
                                <button type="button" onclick="removeImage(this, '@img')" style="display: none; position: absolute; top: 5px; right: 5px; background: #444; color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 12px; line-height: 16px;">× Delete</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Thêm ảnh mới</label>
                <input type="file" id="imageUpload" name="NewImages" class="form-control" multiple />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>
@section Scripts {
    <script>
        function removeImage(button, imageUrl) {
            button.parentElement.remove();
            let input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'DeletedImages';
            input.value = imageUrl;
            document.querySelector('form').appendChild(input);
        }

        document.getElementById('imageUpload').addEventListener('change', function (event) {
            let imagePreview = document.getElementById('imagePreview');
            for (let file of event.target.files) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    let div = document.createElement("div");
                    div.style.position = "relative";
                    div.style.border = "1px solid #ddd";
                    div.style.borderRadius = "4px";
                    div.style.padding = "5px";
                    div.innerHTML = `<img src="${e.target.result}" style="width: 200px; height: 200px; object-fit: cover;" /><button type="button" onclick="this.parentElement.remove()" style="display: none; position: absolute; top: 5px; right: 5px; background: #444; color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 12px; line-height: 16px;">× Delete</button>`;
                    div.onmouseover = () => div.querySelector('button').style.display = 'block';
                    div.onmouseout = () => div.querySelector('button').style.display = 'none';
                    imagePreview.appendChild(div);
                };
                reader.readAsDataURL(file);
            }
        });

        document.querySelectorAll('#imagePreview > div').forEach(div => {
            div.onmouseover = () => div.querySelector('button').style.display = 'block';
            div.onmouseout = () => div.querySelector('button').style.display = 'none';
        });
    </script>
}