@using View.Views.Shared.Helper
@model Domain.Models.Role

@{
    ViewData["Title"] = "Details";
}

<h3>Chi tiết</h3>

<div>
    <h4>Quyền</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Tên
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            Mã vai trò
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RoleCode)
        </dd>
        <dt class="col-sm-2">
            Trạng thái
        </dt>
        <dd class="col-sm-10">
            @StatusHelper.DisplayStatusBadge(Model.Status)
        </dd>
    </dl>
</div>
<div>
    @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
