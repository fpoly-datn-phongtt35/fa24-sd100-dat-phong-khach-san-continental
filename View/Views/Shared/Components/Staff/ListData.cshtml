@using Domain.DTO.Paging
@using View.Models.Paging
@model ResponseData<Domain.Models.Staff>
<table class="table table-bordered mt-3 rounded-3">
    <thead>
        <tr class="text-dark">
            <th scope="col">STT</th>
            <th scope="col">First Name</th>
            <th scope="col">Last Name</th>
            <th scope="col">Email</th>
            <th scope="col">Phone Number</th>
            <th scope="col">Created Time</th>
            <th scope="col" style="width:150px">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            int STT = 0;
            if (Model.CurrentPage == 1)
            {
                STT = 1;
            }
            else
            {
                STT = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
            }
            foreach (var i in Model.data)
            {
                <tr class="text-dark">
                    <th scope="row">@STT</th>
                    <td>@i.FirstName</td>
                    <td>@i.LastName</td>
                    <td>@i.Email</td>
                    <td>@i.PhoneNumber</td>
                    <td>@(i.CreatedTime.HasValue ? i.CreatedTime.Value.ToString("dd-mm-yyy hh:mm") : "N/A")</td>
                    <td>
                        <div class="dropdown">
                            <button class="button1" type="button" id="dropdownMenuButton-@i.Id"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@Url.Content("~/images/icons/menu.png")">
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@i.Id">
                                <button class="btn text-warning dropdown-item" onclick="_staff.LoadForm('@i.Id')">Update</button>
                                <button class="btn text-danger dropdown-item" onclick="_staff.Delete('@i.Id')">Delete</button>
                            </ul>
                        </div>
                       
                    </td>
                </tr>
                STT += 1;
            }
        }
    </tbody>
</table>
@if(Model != null)
{
    @await Component.InvokeAsync("Paging", new
        {
            pageModel = new Paging()
    {
        TotalRecord = Model.totalRecord,
        TotalPage = Model.totalPage,
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        RecordName = "Góp ý",
        PageAction = "_staff.OnPanging({0})",
        PageAction1 = "_staff.OnChangePageSize()"
    }
        })
}