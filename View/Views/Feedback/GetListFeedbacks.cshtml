@using Domain.DTO.Paging
@using View.Models.Paging
@using View.Views.Shared.Helper
@model ResponseData<Domain.DTO.Feedback.FeedbackDto>
@{
    Layout = null;
}
<table class="table table-bordered" style="color: black;">
    <thead>
        <tr>
            <th>STT</th>
            <th>Nội dung</th>
            <th>Rating</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th class="text-center">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.data != null)
        {
            if (Model.data.Count > 0)
            {
                int STT = 0;
                if (Model.CurrentPage == 1)
                {
                    STT = 1;
                }
                else
                {
                    STT = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                }
                foreach (var i in Model.data)
                {
                    <tr class="">
                        <th scope="row">@STT</th>
                        <td>@i.Comments</td>
                        <td>@i.Rating</td>
                        <td>@(i.CreatedTime.HasValue ? i.CreatedTime.Value.ToString("dd-MM-yyyy hh:mm") : "N/A")</td>
                        <td>@if ((int)i.Status == 1)
                            {
                                <span class='badge bg-success'>Đang hiển thị</span>
                            }
                            else
                            {
                                <div class="badge bg-secondary">Đã được ẩn</div>
                            }
                        </td>
                        <td class="d-flex justify-content-center">
                            
                            <div class="dropdown">
                                <button class="button1" type="button" id="dropdownMenuButton-@i.Id"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@Url.Content("~/images/icons/menu.png")">
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@i.Id">
                                   @if(i.Status == Domain.Enums.EntityStatus.Active)
                                   {

                                        <div class="text-center dropdown-item text-danger" style="min-width:120px" onclick="_feedback.OnchangeVisibled(2,'@i.Id')">Ẩn</div>
                                    }
                                    else
                                    {
                                        <div class="text-center dropdown-item" style="min-width:120px" onclick="_feedback.OnchangeVisibled(1,'@i.Id')">Hiển thị</div>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                    STT++;
                }
            }
        }
    </tbody>
</table>
@if (Model != null)
{
    @await Component.InvokeAsync("Paging", new
        {
            pageModel = new Paging()
    {
        TotalRecord = Model.totalRecord,
        TotalPage = Model.totalPage,
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        RecordName = "Góp ý",
        PageAction = "_feedback.OnPanging({0})",
        PageAction1 = "_feedback.OnChangePageSize()"
    }
        })
}